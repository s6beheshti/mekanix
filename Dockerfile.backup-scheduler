FROM node:20-slim

# Match the PostgreSQL 16 server version used by the production Compose stack.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl gnupg bash gzip coreutils findutils \
  && install -d /usr/share/keyrings \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-16 \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g bun@1.4.4

WORKDIR /app

COPY mini-services/backup-scheduler/package.json ./package.json
COPY mini-services/backup-scheduler/index.ts ./index.ts
COPY scripts/backup-db.sh ./scripts/backup-db.sh

RUN mkdir -p /backups && chown -R node:node /app /backups

ENV NODE_ENV=production
ENV PORT=3005
ENV BACKUP_DIR=/backups
ENV BACKUP_SCRIPT=/app/scripts/backup-db.sh

USER node

EXPOSE 3005

CMD ["bun", "run", "index.ts"]
