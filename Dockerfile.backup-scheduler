FROM postgres:16-bookworm

# Reuse the matching PostgreSQL 16 client from the base image; Bun runs the
# scheduler while GPG encrypts backup streams before they reach the volume.
RUN apt-get update \
  && apt-get install -y --no-install-recommends npm gnupg bash gzip ca-certificates \
  && npm install -g bun@1.4.4 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY mini-services/backup-scheduler/package.json ./package.json
COPY mini-services/backup-scheduler/index.ts ./index.ts
COPY scripts/backup-db.sh ./scripts/backup-db.sh

RUN mkdir -p /backups && chown -R postgres:postgres /app /backups

ENV NODE_ENV=production
ENV PORT=3005
ENV BACKUP_DIR=/backups
ENV BACKUP_SCRIPT=/app/scripts/backup-db.sh

USER postgres

EXPOSE 3005

CMD ["bun", "run", "index.ts"]
