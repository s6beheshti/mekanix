FROM postgres:16-bookworm

# The base image supplies matching PostgreSQL 16 client tools. GPG encrypts
# the dump stream before it reaches the persistent backup volume.
RUN apt-get update \
  && apt-get install -y --no-install-recommends npm gnupg gzip bash ca-certificates \
  && npm install -g bun@1.4.4 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY mini-services/backup-scheduler/package.json ./package.json
COPY mini-services/backup-scheduler/index.ts ./index.ts
COPY scripts/backup-db.sh ./scripts/backup-db.sh
COPY scripts/restore-db.sh ./scripts/restore-db.sh

RUN chmod 750 /app/scripts/backup-db.sh /app/scripts/restore-db.sh \
  && mkdir -p /backups \
  && chown -R postgres:postgres /app /backups

ENV NODE_ENV=production
ENV PORT=3005
ENV HOME=/tmp
ENV GNUPGHOME=/tmp/gnupg
ENV BACKUP_DIR=/backups
ENV BACKUP_SCRIPT=/app/scripts/backup-db.sh

USER postgres
EXPOSE 3005
CMD ["bun", "run", "index.ts"]
