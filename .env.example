# ════════════════════════════════════════════════════════════
# MEKANIX — Environment Variables
# ════════════════════════════════════════════════════════════

# ─── Database ───
# Dev: SQLite
DATABASE_URL=file:/home/z/my-project/db/custom.db
# Production: PostgreSQL
# DATABASE_URL=postgresql://mekanix:password@localhost:5432/mekanix

# ─── Auth ───
# Development placeholder only. Production must use a random secret of at least 32 characters.
# JWT_SECRET=replace-with-a-random-32+-character-secret

# ─── Admin Bootstrap (production only) ───
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_EMAIL=admin@mekanix.ir

# ─── Redis ───
# REDIS_URL=redis://:password@localhost:6379
# REDIS_PASSWORD=change-this-to-a-secure-random-password

# ─── SMS Provider ───
# SMS_PROVIDER=console          # dev only
# SMS_PROVIDER=kavenegar        # production
#   KAVENEGAR_API_KEY=your_api_key
#   KAVENEGAR_TEMPLATE=mekanix-otp
# SMS_PROVIDER=melipayamak
#   MELIPAYAMAK_USERNAME=your_username
#   MELIPAYAMAK_PASSWORD=your_password
#   MELIPAYAMAK_SENDER=5000123456
# SMS_PROVIDER=farapayamak
#   FARAPAYAMAK_USERNAME=your_username
#   FARAPAYAMAK_PASSWORD=your_password
#   FARAPAYAMAK_SENDER=5000123456

# ─── Payment Provider ───
# PAYMENT_PROVIDER=simulator    # dev only
# PAYMENT_PROVIDER=zarinpal     # production
#   ZARINPAL_MERCHANT_ID=your_merchant_id
# PAYMENT_PROVIDER=idpay
#   IDPAY_API_KEY=your_api_key

# ─── ETA Provider ───
# NESHAN_API_KEY=your_neshan_key
# GOOGLE_MAPS_API_KEY=your_google_key
# OSRM_API_URL=https://your-osrm-server.com

# ════════════════════════════════════════════════════════════
# Production safety gates (/api/ready returns 503 if):
#   - NODE_ENV=production + SMS_PROVIDER=console
#   - NODE_ENV=production + PAYMENT_PROVIDER=simulator
#   - NODE_ENV=production + DATABASE_URL starts with "file:"
# ════════════════════════════════════════════════════════════

# ─── Production-only requirements ───
# Set these only in the server's secret environment (never commit real values).
# DB_PASSWORD=<random password, at least 24 characters>
# REDIS_PASSWORD=<random password, at least 24 characters>
# ADMIN_BOOTSTRAP_PASSWORD=<strong one-time admin password, at least 16 characters>
# Production requires SMS_PROVIDER=kavenegar|melipayamak|farapayamak
# Production requires PAYMENT_PROVIDER=zarinpal|idpay

# Public canonical origin used to build verified bank callback URLs.
# Production example: https://mekanix.ir
APP_URL=http://localhost:3000

# Set exactly one live gateway provider before production:
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=YOUR_ZARINPAL_MERCHANT_ID
# ZARINPAL_SANDBOX=false
# Or:
# PAYMENT_PROVIDER=idpay
# IDPAY_API_KEY=YOUR_IDPAY_API_KEY
# IDPAY_SANDBOX=false

# Deployment profile: development | staging | production
APP_ENV=development
# Staging uses NODE_ENV=production, APP_ENV=staging, sandbox gateway credentials,
# SMS_PROVIDER=console, and a public HTTPS APP_URL. See docs/STAGING_RUNBOOK.md.
