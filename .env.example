# ─── MEKANIX — Example Environment ───
# Copy to `.env` and edit values for your environment.

# Database
# - SQLite (dev): file path
# - PostgreSQL (prod): postgresql://user:pass@host:5432/db
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Auth
# - Secret used to sign JWTs. MUST be a long, random string in production.
JWT_SECRET=change-this-to-a-secure-secret

# Admin Bootstrap (production only)
# - On first boot, creates an admin user with these credentials if none exists.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@mekanix.ir

# Redis (optional — for distributed rate limiting + idempotency)
# - When unset, MEKANIX falls back to in-memory (single-instance dev mode).
# REDIS_URL=redis://localhost:6379

# SMS Provider (optional — for OTP delivery)
# - When unset or "console", OTP codes are logged to stdout (dev mode).
# SMS_PROVIDER=kavenegar
# KAVENEGAR_API_KEY=
# SMS_PROVIDER=melipayamak
# MELIPAYAMAK_USERNAME=
# MELIPAYAMAK_PASSWORD=
# SMS_PROVIDER=farapayamak
# FARAPAYAMAK_USERNAME=
# FARAPAYAMAK_PASSWORD=

# ETA Provider (optional — for real routing)
# - When unset, MEKANIX falls back to a 40 km/h haversine estimate.
# NESHAN_API_KEY=
# GOOGLE_MAPS_API_KEY=
# OSRM_API_URL=
