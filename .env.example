# ════════════════════════════════════════════════════════════
# MEKANIX — Environment Variables
# ════════════════════════════════════════════════════════════

# ─── Database ───
# Dev: SQLite
DATABASE_URL=file:./dev.db
# Production: PostgreSQL (deploy script also requires DB_PASSWORD)
# DATABASE_URL=postgresql://mekanix:password@localhost:5432/mekanix
# DB_PASSWORD=replace-with-a-long-random-password  # 16+ chars, URL-safe only

# ─── Auth ───
JWT_SECRET=development-only-not-for-production-change-me  # rejected by production/staging readiness; generate: openssl rand -base64url 32

# ─── Admin Bootstrap (production only) ───
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_EMAIL=admin@mekanix.ir

# ─── Redis ───
# Required by production/staging Compose:
# REDIS_PASSWORD=replace-with-a-long-random-password  # 24+ chars, URL-safe only
# REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ─── SMS Provider ───
# Development/staging: console (staging Compose explicitly enables this)
SMS_PROVIDER=console
# Production: choose one real provider; deploy.sh rejects console.
# SMS_PROVIDER=kavenegar
#   KAVENEGAR_API_KEY=your_api_key
#   KAVENEGAR_TEMPLATE=mekanix-otp
# SMS_PROVIDER=melipayamak
#   MELIPAYAMAK_USERNAME=your_username
#   MELIPAYAMAK_PASSWORD=your_password
#   MELIPAYAMAK_SENDER=5000123456
# SMS_PROVIDER=farapayamak
#   FARAPAYAMAK_USERNAME=your_username
#   FARAPAYAMAK_PASSWORD=your_password
#   FARAPAYAMAK_SENDER=5000123456

# ─── Public App URL ───
# Required in production; must be the canonical public HTTPS origin.
# APP_URL=https://mekanix.ir
# DEPLOYMENT_ENV=production  # staging Compose sets DEPLOYMENT_ENV=staging

# ─── Payment Provider ───
# Development/staging: simulator (staging Compose explicitly enables this)
PAYMENT_PROVIDER=simulator
# Production: choose one real provider; deploy.sh rejects simulator.
# PAYMENT_PROVIDER=zarinpal
# ZARINPAL_MERCHANT_ID=your_merchant_id
# Or:
# PAYMENT_PROVIDER=idpay
# IDPAY_API_KEY=your_api_key
# Unsupported providers (including the previous NextPay stub) fail closed.
# Payment amounts are calculated server-side from VIP plans, invoices, or job prepayments.

# ─── Exchange Rate Collector ───
# Production payments require a fresh Telegram-sourced USD/IRR rate.
TELEGRAM_RATE_CHANNEL=NerkhDollarIRT
TELEGRAM_RATE_UNIT=toman  # NerkhDollarIRT publishes unitless prices in Toman
RATE_BOT_POLL_INTERVAL_MS=60000

# ─── ETA Provider ───
# NESHAN_API_KEY=your_neshan_key
# GOOGLE_MAPS_API_KEY=your_google_key
# OSRM_API_URL=https://your-osrm-server.com

# ════════════════════════════════════════════════════════════
# Production safety gates (/api/ready returns 503 if):
#   - PostgreSQL or Redis is unavailable, or DB/Redis passwords are too weak
#   - JWT_SECRET is shorter than 32 characters
#   - SMS_PROVIDER=console or PAYMENT_PROVIDER=simulator
#   - No fresh trusted Telegram USD/IRR rate is available
#   - APP_URL is not a public HTTPS origin
# ════════════════════════════════════════════════════════════
