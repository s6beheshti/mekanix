// MEKANIX — On-Demand Mobile Repair & Maintenance Platform
// Prisma schema (SQLite). Designed to scale to multi-region / multi-currency later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users & Roles ─────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  password  String   @default("demo") // demo only — never store plaintext in prod
  name      String
  avatar    String?
  role      Role     @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  country   String   @default("IR")
  currency  String   @default("USD")
  language  String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer  Customer?
  technician Technician?
  notifications Notification[]
  messagesSent   Message[]   @relation("msgFrom")
  reviewsGiven   Review[]   @relation("revFrom")
  payments       Payment[]

  @@index([role])
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// ───────────────────────── Customer ─────────────────────────

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String?
  taxId     String?
  createdAt DateTime @default(now())

  vehicles       Vehicle[]
  serviceRequests ServiceRequest[]
}

// ───────────────────────── Technician ─────────────────────────

model Technician {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  experienceYears Int     @default(0)
  completedJobs  Int     @default(0)
  rating         Float   @default(0)
  reviewCount    Int     @default(0)
  hourlyRate     Float   @default(45)
  travelFeeBase  Float   @default(15)
  status         TechStatus @default(OFFLINE)
  verified       Boolean @default(false)
  level          TechLevel @default(BRONZE)
  lat            Float?
  lng            Float?
  heading        Float?
  availableNow   Boolean @default(true)
  responseMins   Int     @default(12)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  specialties    TechnicianSpecialty[]
  certifications Certification[]
  serviceAreas   ServiceArea[]
  jobsAssigned   Job[]       @relation("jobTech")
  requestsMatched ServiceRequest[] @relation("reqMatchTech")
  reviews        Review[]    @relation("revTech")

  @@index([status, availableNow])
}

enum TechStatus {
  ONLINE
  OFFLINE
  ON_JOB
}

enum TechLevel {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model TechnicianSpecialty {
  id           String  @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     String // e.g. "engine", "electrical", "hydraulic"
  label        String
}

model Certification {
  id           String   @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  name         String
  issuer       String
  year         Int
  verified     Boolean @default(false)
}

model ServiceArea {
  id           String  @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  name         String
  lat          Float
  lng          Float
  radiusKm     Float   @default(25)
}

// ───────────────────────── Vehicles & Machinery ─────────────────────────

model Vehicle {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        MachineType
  make        String
  model       String
  year        Int
  vin         String?
  plate       String?
  engineHours Int?
  location    String?
  lat         Float?
  lng         Float?
  image       String?
  notes       String?
  createdAt   DateTime @default(now())

  serviceRequests ServiceRequest[]
}

enum MachineType {
  CAR
  TRUCK
  BUS
  EXCAVATOR
  LOADER
  BULLDOZER
  GRADER
  AGRI
  INDUSTRIAL
  OTHER
}

// ───────────────────────── Service Requests & Jobs ─────────────────────────

model ServiceRequest {
  id          String   @id @default(cuid())
  code        String   @unique // human friendly e.g. SR-2041
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  category    String   // service category slug
  urgency     Urgency  @default(NORMAL)
  title        String
  description String
  mediaUrls   String   // JSON array of uploaded media (sqlite has no native array)
  voiceNote   String?
  address     String
  lat         Float
  lng         Float
  status      RequestStatus @default(OPEN)
  matchedTechId String?
  matchedTech   Technician? @relation("reqMatchTech", fields: [matchedTechId], references: [id])
  job         Job?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

enum Urgency {
  NORMAL
  URGENT
  EMERGENCY
}

enum RequestStatus {
  OPEN
  MATCHED
  ASSIGNED
  CANCELLED
  EXPIRED
}

model Job {
  id           String   @id @default(cuid())
  code         String   @unique // JOB-...
  requestId    String   @unique
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation("jobTech", fields: [technicianId], references: [id])
  status       JobStatus @default(REQUESTED)
  etaMins      Int      @default(25)
  customerApproved Boolean @default(false)
  diagnosis    String?
  technicianNotes String?
  replacedParts String? // JSON
  startedAt    DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  diagnosisRecords Diagnosis[]
  parts      Part[]
  invoice    Invoice?
  messages   Message[]
  reviews    Review[]  @relation("revJob")
  tracking   TrackingEvent[]
  warranty   Warranty?

  @@index([status])
  @@index([technicianId])
}

enum JobStatus {
  REQUESTED
  ACCEPTED
  EN_ROUTE
  ARRIVED
  DIAGNOSING
  REPAIRING
  WAITING_APPROVAL
  COMPLETED
  CANCELLED
}

model Diagnosis {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  summary   String
  faultCode String?
  severity  String  @default("medium")
  mediaUrls String?
  createdAt DateTime @default(now())
}

model Part {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name      String
  sku       String?
  quantity  Int     @default(1)
  unitPrice Float
  createdAt DateTime @default(now())
}

model TrackingEvent {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  heading   Float?
  ts        DateTime @default(now())
}

// ───────────────────────── Invoices & Payments ─────────────────────────

model Invoice {
  id        String  @id @default(cuid())
  code      String  @unique // INV-...
  jobId     String  @unique
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  laborHours Float  @default(1)
  laborRate  Float  @default(45)
  laborTotal Float  @default(0)
  partsTotal Float  @default(0)
  travelFee  Float  @default(0)
  subtotal   Float  @default(0)
  taxRate    Float  @default(0.09)
  taxTotal   Float  @default(0)
  discount   Float  @default(0)
  total      Float  @default(0)
  currency   String @default("USD")
  notes      String?
  status     InvoiceStatus @default(DRAFT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  payment    Payment?
}

enum InvoiceStatus {
  DRAFT
  SENT
  APPROVED
  PAID
  OVERDUE
  REFUNDED
}

model Payment {
  id         String  @id @default(cuid())
  code       String  @unique
  invoiceId  String  @unique
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  amount     Float
  currency   String  @default("USD")
  method     String  @default("card")
  status     PaymentStatus @default(PENDING)
  createdAt  DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ───────────────────────── Reviews ─────────────────────────

model Review {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation("revJob", fields: [jobId], references: [id], onDelete: Cascade)
  technicianId String
  technician   Technician @relation("revTech", fields: [technicianId], references: [id])
  fromUserId String
  fromUser   User    @relation("revFrom", fields: [fromUserId], references: [id])
  rating     Int
  comment    String?
  tags       String?
  createdAt  DateTime @default(now())
}

// ───────────────────────── Messaging ─────────────────────────

model Message {
  id        String  @id @default(cuid())
  jobId     String?
  job       Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser  User    @relation("msgFrom", fields: [fromUserId], references: [id])
  kind      String  @default("text") // text | image | system | voice
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([jobId])
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String  // request_accepted | estimate_ready | payment_required | ...
  title     String
  body      String
  category  String  @default("general") // job | payment | message | system | maintenance
  link      String?
  read      Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ───────────────────────── Warranty ─────────────────────────

model Warranty {
  id        String  @id @default(cuid())
  jobId     String  @unique
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  months    Int     @default(6)
  kmLimit   Int?
  terms     String?
  active    Boolean @default(true)
  createdAt DateTime @default(now())
}

// ───────────────────────── Service Categories (platform) ─────────────────────────

model ServiceCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  icon      String
  description String?
  basePrice Float  @default(0)
  active    Boolean @default(true)
  order     Int    @default(0)
}
